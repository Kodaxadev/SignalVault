{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Signal Vault Companion",
  "version": "0.0.0",
  "identifier": "dev.signalvault.companion",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Signal Vault Companion",
        "width": 360,
        "height": 460,
        "x": 24,
        "y": 24,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
